# =============================================================================
# VietLegalGraphRAG — root env example (backend runtime).
# Copy to .env and fill in real values. Placeholders only — never commit secrets.
# Source of truth for variables the backend reads: src/backend/app/config.py.
# =============================================================================

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
# Optional basic-auth fallback when no API key is set.
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# Physical index and query alias used by the backend.
ELASTICSEARCH_INDEX=vietlegal_chunks_hybrid_v1
ELASTICSEARCH_ALIAS=vietlegal_chunks
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_REQUEST_TIMEOUT=60

# DEPRECATED — NOT read by the backend (config.py). Kept for pipeline-era
# compatibility only; do not set for the API service.
ELASTICSEARCH_DENSE_INDEX=vietlegal_dense
ELASTICSEARCH_SPARSE_INDEX=vietlegal_sparse

# Neo4j. Production backend uses Docker bridge to vietlegal-neo4j.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=neo4j

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# UNUSED — NOT read by the backend. Retrieval mode and temperature are
# request-level fields on /search and /answer, not env config.
DEFAULT_RETRIEVAL_MODE=hybrid
DEFAULT_TEMPERATURE=0.2

RERANK_PROVIDER=voyage
RERANK_MODEL=rerank-2.5
# Comma-separated models clients may request per-call ("*" allows any).
# Default when unset: rerank-2.5,rerank-2.5-lite
RERANK_MODEL_ALLOWLIST=rerank-2.5,rerank-2.5-lite
VOYAGE_API_KEY=

# Dense (kNN) retrieval embeddings. "none" disables dense search (BM25-only).
# Providers: none | voyage | openai-compatible.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=voyage-3.5
# Falls back to VOYAGE_API_KEY when unset.
EMBEDDING_API_KEY=
# Only for openai-compatible embedding endpoints.
EMBEDDING_BASE_URL=
# Expected query-vector dims; 0 = infer from model name when known.
# Startup disables dense search if this mismatches the index mapping.
EMBEDDING_DIMS=0
# Dense kNN num_candidates = max(candidate_k * factor, minimum).
DENSE_NUM_CANDIDATES_FACTOR=4
DENSE_MIN_NUM_CANDIDATES=100

# UNUSED — NOT read by the backend. Device and timeout are request-level
# fields (rerank.device, rerank.timeout_ms).
RERANK_DEVICE=auto
RERANK_TIMEOUT_MS=30000

# When true (default), missing/broken external services degrade to demo/noop
# fallbacks instead of failing startup.
RUNTIME_FALLBACK_ENABLED=true

# UNUSED by backend code (uvicorn bind host is set by the container CMD).
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# OCR: "none" disables POST /documents/ocr; "google" uses Google Vision.
OCR_PROVIDER=none
# Max file size for OCR uploads (MB); must be positive.
OCR_MAX_FILE_MB=10
# Allowed MIME types for OCR uploads (comma-separated).
OCR_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf
# Language hints for Google Vision OCR (comma-separated BCP-47 codes).
OCR_LANGUAGE_HINTS=vi,en

# Google Vision API Credentials (used when OCR_PROVIDER=google).
# Individual vars take precedence over GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=your-gcp-project-id
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=your-private-key-id
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=your-service-account-email@your-gcp-project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_CLIENT_ID=your-client-id

# VietLegalGraphRAG backend runtime env example.
# Copy to .env and fill real values. Never commit secrets.
# Source of truth: src/backend/app/config.py

# Open WebUI admin credentials & secret (for container auto-provisioning)
WEBUI_ADMIN_EMAIL=admin@vietlegal.local
WEBUI_ADMIN_PASSWORD=change-me-to-a-strong-password
WEBUI_SECRET_KEY=generate-with-openssl-rand-hex-32

# Elasticsearch Cloud or local Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=vietlegal_chunks_hybrid_v1
ELASTICSEARCH_ALIAS=vietlegal_chunks
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_REQUEST_TIMEOUT=60

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=neo4j

# LLM provider
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Voyage reranker
RERANK_PROVIDER=voyage
RERANK_MODEL=rerank-2.5
RERANK_MODEL_ALLOWLIST=rerank-2.5,rerank-2.5-lite
VOYAGE_API_KEY=

# Dense query embeddings. Must match index-time dense corpus model.
# Provider: "hf" (PyTorch, default) or "onnx" (onnxruntime, no torch).
# For ONNX, pre-export model via: python src/infra/scripts/export_vnlegal_onnx.py
EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL=darklethelong/vnlegal-lal
EMBEDDING_ONNX_MODEL_PATH=/app/onnx_model/model.onnx
EMBEDDING_ONNX_TOKENIZER_PATH=/app/onnx_model/tokenizer.json
EMBEDDING_DEVICE=auto
EMBEDDING_CACHE_DIR=/app/.cache/huggingface
EMBEDDING_MAX_LENGTH=1024
HF_HUB_DISABLE_SYMLINKS_WARNING=1
EMBEDDING_DIMS=0
DENSE_NUM_CANDIDATES_FACTOR=4
DENSE_MIN_NUM_CANDIDATES=100

# Runtime behavior
RUNTIME_FALLBACK_ENABLED=true
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# OCR
OCR_PROVIDER=none
OCR_MAX_FILE_MB=10
OCR_MAX_PDF_PAGES=5
OCR_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf
OCR_LANGUAGE_HINTS=vi,en

# Google Vision credentials. Prefer an ignored JSON file.
# To convert inline GOOGLE_SERVICE_ACCOUNT_* values from an old .env:
#   python src/infra/scripts/materialize_google_credentials.py --env-file .env --output credentials/google-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-service-account.json

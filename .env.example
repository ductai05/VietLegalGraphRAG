ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_DENSE_INDEX=vietlegal_dense
ELASTICSEARCH_SPARSE_INDEX=vietlegal_sparse

# Neo4j — use bolt:// for local, neo4j+s:// for production (TLS required)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# VM auto-start/stop management
# Provider: none (local/always-on), gcp, aws
VM_PROVIDER=none
VM_INSTANCE_ID=
VM_ZONE=
VM_PROJECT=
VM_IDLE_TIMEOUT=600

LLM_PROVIDER=mock
LLM_API_KEY=
DEFAULT_RETRIEVAL_MODE=hybrid
DEFAULT_TEMPERATURE=0.2

RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=auto
RERANK_TIMEOUT_MS=30000

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# OCR
OCR_DETECTOR_MODEL=PP-OCRv6_medium_det
OCR_RECOGNIZER_MODEL=PP-OCRv6_medium_rec
OCR_RECOGNITION_BACKEND=easyocr
OCR_EASYOCR_LANGUAGES=vi,en
OCR_RECOGNITION_BATCH_SIZE=8
OCR_CROP_PADDING_RATIO=0.15
OCR_ENGINE=transformers
OCR_DEVICE=auto
OCR_TEXT_SCORE_THRESHOLD=0.20

# PDF limits
PDF_DPI=180
MAX_PDF_DPI=300
MAX_PDF_PAGES=50
MAX_UPLOAD_MB=50

# Gemini. Có thể để trống và nhập key trực tiếp trên giao diện.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_CHUNK_CHARS=30000
GEMINI_MAX_CHUNKS=12
GEMINI_MAX_OUTPUT_TOKENS=4096

# Gradio
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
GRADIO_QUEUE_SIZE=16

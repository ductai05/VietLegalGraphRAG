meta {
  name: 03 Search Dense
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/search
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "query": "dieu kien ket hon theo phap luat Viet Nam",
    "retrieval_mode": "dense",
    "top_k": 3,
    "rerank": {
      "enabled": false
    },
    "graph": {
      "enabled": false,
      "use_lightrag": false,
      "max_hops": 0
    },
    "llm": {
      "temperature": 0.2,
      "max_context_chunks": 3
    }
  }
}

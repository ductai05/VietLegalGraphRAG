meta {
  name: 05 Answer Graph LLM
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/answer
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "query": "điều kiện kết hôn theo pháp luật Việt Nam",
    "retrieval_mode": "hybrid",
    "top_k": 5,
    "rerank": {
      "enabled": true,
      "model": "rerank-2.5"
    },
    "graph": {
      "enabled": true,
      "use_lightrag": true,
      "max_hops": 1
    },
    "llm": {
      "temperature": 0.2,
      "max_context_chunks": 5
    }
  }
}

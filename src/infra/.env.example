# =============================================================================
# VietLegalGraphRAG — Demo Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values for your environment.
#   cp src/infra/.env.example src/infra/.env
#
# All values shown below are PLACEHOLDERS.  Do NOT commit real secrets.
# =============================================================================

# --- API ---
BACKEND_PORT=8000

# --- Elasticsearch Cloud (external managed service) ---
ELASTICSEARCH_URL=https://your-deployment.es.us-central1.gcp.cloud.es.io:9243
ELASTICSEARCH_API_KEY=your-elasticsearch-api-key
ELASTICSEARCH_INDEX=vietlegal_chunks_hybrid_v1
ELASTICSEARCH_ALIAS=vietlegal_chunks

# --- Neo4j VPS / Droplet (external) ---
# Use bolt:// for local dev, neo4j+ssc:// for TLS protected production Droplet
NEO4J_URI=bolt://your-neo4j-vps:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- Google Cloud Vision OCR (external managed service) ---
# Credentials directory is gitignored.  Never commit service-account JSON files.
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-service-account.json

# --- Reranker ---
RERANK_PROVIDER=voyage
RERANK_MODEL=rerank-2.5
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxx
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- LLM ---
LLM_PROVIDER=mock

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:5173

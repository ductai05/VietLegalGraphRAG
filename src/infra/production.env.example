BACKEND_PORT=8000
FRONTEND_PORT=80
FRONTEND_ORIGIN=http://<DROPLET_IP>

ELASTICSEARCH_URL=https://<elastic-cloud-endpoint>:9243
ELASTICSEARCH_API_KEY=<elastic-api-key>
ELASTICSEARCH_INDEX=vietlegal_chunks_hybrid_v1
ELASTICSEARCH_ALIAS=vietlegal_chunks
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_REQUEST_TIMEOUT=60
ELASTICSEARCH_SPARSE_MAX_CHUNK_MB=8
ELASTICSEARCH_DENSE_MAX_CHUNK_MB=8
ELASTICSEARCH_RETRY_INITIAL_BACKOFF=1
ELASTICSEARCH_RETRY_MAX_BACKOFF=60

# Embedding provider: "hf" (PyTorch) or "onnx" (onnxruntime). ONNX recommended for smaller images.
# Pre-export model via: python src/infra/scripts/export_vnlegal_onnx.py
EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL=darklethelong/vnlegal-lal
EMBEDDING_DEVICE=auto
EMBEDDING_CACHE_DIR=/app/.cache/huggingface
EMBEDDING_MAX_LENGTH=1024
HF_HUB_DISABLE_SYMLINKS_WARNING=1
EMBEDDING_DIMS=0
EMBEDDING_ONNX_MODEL_PATH=/app/onnx_model/model.onnx
EMBEDDING_ONNX_TOKENIZER_PATH=/app/onnx_model/tokenizer.json
DENSE_NUM_CANDIDATES_FACTOR=4
DENSE_MIN_NUM_CANDIDATES=100

NEO4J_URI=bolt://vietlegal-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<neo4j-password>
NEO4J_DATABASE=neo4j

GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-service-account.json
OCR_PROVIDER=google
OCR_MAX_FILE_MB=10
OCR_MAX_PDF_PAGES=5
OCR_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf
OCR_LANGUAGE_HINTS=vi,en

RERANK_PROVIDER=voyage
RERANK_MODEL=rerank-2.5
RERANK_MODEL_ALLOWLIST=rerank-2.5,rerank-2.5-lite
VOYAGE_API_KEY=<voyage-api-key>

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=<openai-compatible-base-url>
LLM_API_KEY=<llm-api-key>
LLM_MODEL=<model-name>

RUNTIME_FALLBACK_ENABLED=true
